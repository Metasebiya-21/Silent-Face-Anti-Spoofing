# Copy to .env for local runs. On the server, set VAULT_* (and PRODUCTION=true) as real environment
# variables instead; the other values then come from the Vault secret at VAULT_PATH, keyed by lowercase name.

# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=
# VAULT_PATH=liveness-service/config
# PRODUCTION=false

REDIS_URL=redis://:password@localhost:6379/0
LIVENESS_API_KEY=change-me
TUSD_URL=http://localhost:8021/files/
TUSD_DATA_DIR=./data
SESSION_SECRET=change-me-too   # signs session tokens; required in production
# SESSION_TTL_SECONDS=600
# KEEPALIVE_SECONDS=15
